# Copy this file to .env and fill in real values. NEVER commit .env.
DATABASE_URL=sqlite:///./jobhopper.db

# Secret used to sign auth tokens/sessions (generate a random string).
SECRET_KEY=change-me-to-a-long-random-string

# CORS: frontend origin(s), comma-separated (Live Server default shown).
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# JSearch on RapidAPI — get your key at rapidapi.com (JSearch playground).
# Free tier is limited (~200 requests/month), so ingest sparingly.
RAPIDAPI_KEY=your-rapidapi-key-here
RAPIDAPI_HOST=jsearch.p.rapidapi.com
